{
  "name": "keyboard-studio",
  "private": true,
  "version": "2.0.0",
  "description": "A computer-keyboard piano with sampled grand piano, synthesised instruments, multi-part songs, learn mode, recording and MIDI export. Runs entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "probe:audio": "node scripts/audio-probe.mjs",
    "probe:spectrum": "node scripts/audio-spectrum.mjs",
    "screenshots": "node scripts/screenshots.mjs docs/screenshots/after"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
